{
  "manifest_version": 3,
  "name": "Autofill Assistant (Local Prototype)",
  "version": "0.1.0",
  "description": "Reviews a fill plan from your own local FastAPI backend and fills only the safe fields you approve, on local sample forms and on supported application pages you open yourself. Never submits, never clicks Apply.",
  "action": {
    "default_title": "Autofill Assistant (local only)",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*"
      ],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
