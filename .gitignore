# --- Local candidate/profile data (sensitive, never commit) ---
backend/app/data/profile.json
backend/app/data/*.json

# --- Automation reports (redacted, but still local-only; keep the folder) ---
backend/app/data/automation-reports/*.json
!backend/app/data/automation-reports/.gitkeep

# --- Mapping overrides (local-only, user-controlled; keep the folder) ---
backend/app/data/mapping-overrides/*.json
!backend/app/data/mapping-overrides/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
*.local

# --- Node / build output ---
node_modules/
frontend/dist/
dist/

# --- Chrome extension build output (Phase 6; rebuild with `npm run build`) ---
extension/dist/

# --- Phase 7: anything captured from a real application page ---
# The synthetic fixtures in test-fixtures/platform-pages/ ARE committed. This folder
# is for a saved copy of a real page a developer was debugging against, which would
# contain a live posting's markup and possibly their own answers. Never commit those.
test-fixtures/real-pages/

# --- OS / editor ---
.DS_Store
Thumbs.db
