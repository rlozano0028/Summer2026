# --- Local candidate/profile data (sensitive, never commit) ---
backend/app/data/profile.json
backend/app/data/*.json

# --- Automation reports (redacted, but still local-only; keep the folder) ---
backend/app/data/automation-reports/*.json
!backend/app/data/automation-reports/.gitkeep

# --- Mapping overrides (local-only, user-controlled; keep the folder) ---
backend/app/data/mapping-overrides/*.json
!backend/app/data/mapping-overrides/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
*.local

# --- Node / frontend build output ---
frontend/dist/
dist/

# --- OS / editor ---
.DS_Store
Thumbs.db
